  "definitions": {
    "requests.CreateCustomerRegistSourceRequest": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "name": {
          "type": "string",
          "maxLength": 50
        }
      }
    },
    "requests.CreateHolidayRequest": {
      "type": "object",
      "required": [
        "date",
        "name"
      ],
      "properties": {
        "affects_rates": {
          "type": "number",
          "minimum": 0
        },
        "date": {
          "type": "string",
          "example": "2026-01-01"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "requests.CreatePaymentMethodRequest": {
      "type": "object",
      "required": [
        "code",
        "name"
      ],
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 20
        },
        "config": {
          "description": "Kita terima sebagai slice string biasa",
          "type": "array",
          "items": {
            "type": "string"
